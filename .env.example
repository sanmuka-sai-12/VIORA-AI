# Local development only. Copy to .env and change all placeholder secrets.
POSTGRES_PASSWORD=change-this-local-password
# Runtime must use a separately provisioned non-owner role; see docs/authorization.md.
DATABASE_URL=postgresql+psycopg://viora_app:replace-runtime-password@127.0.0.1:5432/viora
# Supply MIGRATION_DATABASE_URL separately in the migration process environment.
# Required when composing AuthService: generate at least 32 random bytes; no default key.
AUTH_SIGNING_KEY=
AUTH_ISSUER=viora
AUTH_AUDIENCE=viora-api
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=604800
AUTH_ABSOLUTE_SECONDS=2592000
APP_ENV=development
MEDIA_STORAGE_DIR=./storage
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_AI_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
