{
  "components": {
    "schemas": {
      "ArtifactVersionRef": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "resource_id": {
            "format": "uuid",
            "title": "Resource Id",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "kind",
          "resource_id",
          "version_id",
          "sha256"
        ],
        "title": "ArtifactVersionRef",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "IdempotentRequest": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "key": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "operation": {
            "title": "Operation",
            "type": "string"
          },
          "payload_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Payload Hash",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "tenant_id",
          "operation",
          "key",
          "payload_hash"
        ],
        "title": "IdempotentRequest",
        "type": "object"
      },
      "JobAcceptance": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "JobAcceptance",
        "type": "object"
      },
      "JobState": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "retry_wait",
          "failed",
          "cancelled"
        ],
        "title": "JobState",
        "type": "string"
      },
      "JobStatus": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          }
        },
        "required": [
          "job_id",
          "state"
        ],
        "title": "JobStatus",
        "type": "object"
      },
      "Page_SourceSummary_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "Page[SourceSummary]",
        "type": "object"
      },
      "SourceEvidence": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          },
          "section_id": {
            "format": "uuid",
            "title": "Section Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ArtifactVersionRef"
          }
        },
        "required": [
          "source",
          "section_id",
          "page"
        ],
        "title": "SourceEvidence",
        "type": "object"
      },
      "SourceSummary": {
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "title"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "TenantContext": {
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array",
            "uniqueItems": true
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "tenant_id",
          "roles"
        ],
        "title": "TenantContext",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "VIORA-AI",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
